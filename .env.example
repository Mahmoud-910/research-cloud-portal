# ── Copy to .env and fill in real values ──────────────────────
# Generate SECRET_KEY with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX

FLASK_ENV=development

# Initial user passwords (change on first login)
ADMIN_PASSWORD=Admin@RCP2025!
USER1_PASSWORD=User1@RCP2025!
USER2_PASSWORD=User2@RCP2025!

# Database (SQLite for dev, PostgreSQL for prod)
# DATABASE_URL=postgresql://rcp_user:password@localhost:5432/rcpdb

# Celery + Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# OpenNebula
ONE_XMLRPC=http://localhost:2633/RPC2
ONE_USER=oneadmin
ONE_PASS=REPLACE_WITH_ONEADMIN_PASSWORD

# Production only
# SESSION_COOKIE_SECURE=True
# PORT=5000
